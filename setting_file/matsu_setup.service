# /etc/systemd/system/matsu_setup.service
# 松本VM：初回/更新時に venv 作成 + pip install -r requirements.txt を実行する oneshot

[Unit]
Description=Matsu VM setup (create venv and install python deps)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/3ETU/matsu_temp_box
Environment=PYTHONUNBUFFERED=1

# pip install が長引く可能性があるので、必要なら延長
TimeoutStartSec=15min

# なるべく壊れにくい1行実行に寄せる（複雑化したらsetup.sh化推奨）
ExecStart=/bin/bash -lc 'set -euo pipefail; cd /root/3ETU/matsu_temp_box; if [ ! -d ".venv" ]; then python3 -m venv .venv; fi; . .venv/bin/activate; python -m pip install -U pip wheel setuptools; pip install -r requirements.txt'

# → 他サービスが Requires=matsu_setup.service しているとき、「一度成功したセットアップが完了済み」扱いにできる。
RemainAfterExit=yes

# 自動起動の本懐。systemctl enableすると自動起動するようになる。
[Install]
# .target側にこのサービスが必要だと教える
WantedBy=multi-user.target