# /etc/systemd/system/matsu_flask.service
# Flask を常駐起動（matsu_setup.service 完了後に起動）
# ポートは flaskr.py 側で 8080 にしておく

[Unit]
Description=Matsu Flask receiver (flaskr.py)
Wants=network-online.target
After=network-online.target
Requires=matsu_setup.service
After=matsu_setup.service

[Service]
Type=simple
User=e231238
WorkingDirectory=/home/e231238/3ETU/matsu_temp_box/app
Environment=PYTHONUNBUFFERED=1

# venv の python で flaskr.py を起動
ExecStart=/home/e231238/3ETU/matsu_temp_box/.venv/bin/python /home/e231238/3ETU/matsu_temp_box/app/flaskr.py

# 異常終了時のみ再起動（Ctrl+C 等の手動停止は通常ここでは起きない想定）
Restart=on-failure
RestartSec=3

# systemd 側で強制終了する時の猶予
TimeoutStopSec=10

# 予期せぬ多重起動を避けたい場合の保険（任意）
# ExecStartPre=/usr/bin/bash -lc 'if ss -lntp | grep -q ":8080"; then echo "Port 8080 already in use"; exit 1; fi'

[Install]
WantedBy=multi-user.target