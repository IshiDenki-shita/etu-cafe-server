# 松本VMに入れる、初回/更新時に venv 作成＋pip install -r requirements.txt

[Unit]
Description=Matsu VM setup (create venv and install python deps)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=e231238
WorkingDirectory=/home/e231238/3ETU/matsu_temp_box
Environment=PYTHONUNBUFFERED=1

# 既に .venv があれば作り直さない（必要なら手動で消して作り直す）
# ExecStartでコマンドを実行していく
ExecStart=/bin/bash -lc '\
  set -euo pipefail; \
  cd /home/e231238/3ETU/matsu_temp_box; \
  if [ ! -d ".venv" ]; then python3 -m venv .venv; fi; \
  . .venv/bin/activate; \
  python -m pip install -U pip wheel setuptools; \
  pip install -r requirements.txt \
'
ここで bash に渡すコマンド文字列が終わる。

# 実行後にactive扱いとすることで、他のコマンドからセットアップ済みだと分かる
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target